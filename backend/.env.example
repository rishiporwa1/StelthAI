# Copy this to .env and fill in your values
# Never commit .env to git!

SECRET_KEY=your-very-secret-key-here-change-this
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS — your React dev server
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email Configuration
# For TESTING: Use console backend (prints emails to terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For PRODUCTION: Uncomment the line below and comment out the console backend above
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Gmail SMTP Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# IMPORTANT: Replace with your actual Gmail address
EMAIL_HOST_USER=your@gmail.com

# IMPORTANT: Use Gmail App Password (not your regular password)
# Get it from: https://myaccount.google.com/apppasswords
EMAIL_HOST_PASSWORD=your-app-password

# Sender email (what recipients see as "From")
DEFAULT_FROM_EMAIL=TechNova <your@gmail.com>

# YOUR email address where contact form submissions will be sent
CONTACT_RECIPIENT_EMAIL=your@gmail.com

# PostgreSQL (leave blank to use SQLite in dev)
# DB_NAME=technova
# DB_USER=postgres
# DB_PASSWORD=yourpassword
# DB_HOST=localhost
# DB_PORT=5432
